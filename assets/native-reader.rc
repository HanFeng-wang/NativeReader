IDI_APP ICON "native-reader.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Native Reader"
            VALUE "FileDescription", "Native Reader - fast native text viewer"
            VALUE "FileVersion", "0.1.1"
            VALUE "InternalName", "native-reader"
            VALUE "OriginalFilename", "native-reader.exe"
            VALUE "ProductName", "Native Reader"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
